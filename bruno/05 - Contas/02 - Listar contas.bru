meta {
  name: Listar contas
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/contas
  body: none
  auth: none
}

params:query {
  page: 0
  size: 20
  sort: vencimento,asc
  ~tipo: PAGAR
  ~status: VENCIDA
  ~parceiroId: {{parceiroId}}
  ~vencimentoInicio: {{dataInicio}}
  ~vencimentoFim: {{dataFim}}
}

tests {
  test("retorna HTTP 200", function() {
    expect(res.status).to.equal(200);
  });
}

