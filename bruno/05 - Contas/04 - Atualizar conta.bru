meta {
  name: Atualizar conta
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/contas/{{contaId}}
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "descricao": "Serviço administrativo Bruno atualizado",
    "valor": 1050.00,
    "tipo": "PAGAR",
    "categoria": "Serviços profissionais",
    "vencimento": "2026-12-20",
    "recorrencia": "UNICA",
    "observacao": "Conta atualizada antes da liquidação",
    "parceiroId": {{parceiroId}}
  }
}

tests {
  test("retorna HTTP 200", function() {
    expect(res.status).to.equal(200);
  });
}

