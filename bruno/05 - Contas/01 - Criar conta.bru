meta {
  name: Criar conta a pagar
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/contas
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "descricao": "Serviço administrativo Bruno",
    "valor": 980.00,
    "tipo": "PAGAR",
    "categoria": "Serviços profissionais",
    "vencimento": "2026-12-15",
    "recorrencia": "UNICA",
    "observacao": "Conta criada para testar atualização e liquidação",
    "parceiroId": {{parceiroId}}
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("contaId", res.body.id);
  }
}

tests {
  test("retorna HTTP 201", function() {
    expect(res.status).to.equal(201);
  });
}

