meta {
  name: Criar lançamento
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/lancamentos
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "descricao": "Aquisição de equipamentos pelo Bruno",
    "valor": 2750.00,
    "tipo": "DESPESA",
    "categoria": "Equipamentos",
    "dataLancamento": "2026-11-12",
    "observacao": "Registro criado pela coleção Bruno"
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("lancamentoId", res.body.id);
  }
}

tests {
  test("retorna HTTP 201", function() {
    expect(res.status).to.equal(201);
  });
}

