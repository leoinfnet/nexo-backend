meta {
  name: Listar lançamentos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/lancamentos
  body: none
  auth: none
}

params:query {
  page: 0
  size: 20
  sort: dataLancamento,desc
  ~tipo: DESPESA
  ~categoria: Software
  ~dataInicio: {{dataInicio}}
  ~dataFim: {{dataFim}}
  ~valorMinimo: 100
  ~valorMaximo: 5000
}

tests {
  test("retorna HTTP 200", function() {
    expect(res.status).to.equal(200);
  });
}

