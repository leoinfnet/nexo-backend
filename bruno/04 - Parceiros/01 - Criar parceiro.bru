meta {
  name: Criar parceiro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/parceiros
  body: json
  auth: none
}

script:pre-request {
  const timestamp = Date.now().toString();
  const documento = "9" + timestamp;
  bru.setEnvVar("parceiroDocumento", documento);
  bru.setEnvVar("parceiroEmail", "bruno." + timestamp + "@nexo.local");
}

headers {
  content-type: application/json
}

body:json {
  {
    "nome": "Parceiro criado pelo Bruno",
    "documento": "{{parceiroDocumento}}",
    "email": "{{parceiroEmail}}",
    "telefone": "(21) 99999-0001",
    "tipo": "AMBOS",
    "ativo": true
  }
}

script:post-response {
  if (res.status === 201 && res.body.id) {
    bru.setEnvVar("parceiroId", res.body.id);
  }
}

tests {
  test("retorna HTTP 201", function() {
    expect(res.status).to.equal(201);
  });
}

