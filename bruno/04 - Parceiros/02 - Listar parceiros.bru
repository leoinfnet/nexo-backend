meta {
  name: Listar parceiros
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/parceiros
  body: none
  auth: none
}

params:query {
  page: 0
  size: 20
  sort: nome,asc
  ~tipo: FORNECEDOR
  ~nome: Nuvem
  ~ativo: true
}

tests {
  test("retorna HTTP 200", function() {
    expect(res.status).to.equal(200);
  });
}

